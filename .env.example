# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=
# Use the SERVICE ROLE key here (not anon) — backend bypasses RLS by design.
# Keep this secret. Never send it to the Flutter app.
SUPABASE_SERVICE_KEY=
# Cloudinary (Dashboard -> Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Custom JWT auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d